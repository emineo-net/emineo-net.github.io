<Project>
  <PropertyGroup>
    <!-- Aktiviert das Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Hier definieren Sie die Pakete und deren Versionen zentral. Ein Beispiel: -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
    <PackageVersion Include="System.Net.Http.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <!--<PackageVersion Include="Supabase" Version="8.1.1" />-->
    <PackageVersion Include="Supabase" Version="1.1.1" />
    <!--<PackageVersion Include="Supabase" Version="0.16.2" />-->

  </ItemGroup>
  <Target Name="MonoDebuggerReminder" BeforeTargets="Build">
    <Message Importance="high" Text="💡 ERINNERUNG AN MICH SELBST: Falls der F5-Start im Browser hieeeer einfriert, hast du den Haken bei 'Neuen .NET 9+ Mono-Debugger' unter Extras -&gt; Optionen -&gt; Vorschaufeatures wieder aktiviert! Schalte ihn aus, bis MS den Bug gefixt hat." />
  </Target>
</Project>