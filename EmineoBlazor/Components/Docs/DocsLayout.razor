@* Components/Docs/DocsLayout.razor *@

<div class="docs-page">
    <div class="container">
        <nav class="docs-breadcrumb" aria-label="Breadcrumb">
            <a href="/docs">Docs</a>
            @if (!string.IsNullOrEmpty(Section))
            {
                <span class="sep">/</span>
                <a href="@SectionUrl">@Section</a>
            }
            <span class="sep">/</span>
            <span class="current">@PageTitle</span>
        </nav>

        <div class="docs-grid">
            <DocsSidebar/>

            <main class="docs-main">
                @if (!string.IsNullOrEmpty(HeaderHtml))
                {
                    <header class="docs-header">
                        @((MarkupString)HeaderHtml)
                    </header>
                }

                @ChildContent

                <div class="docs-footer-links">
                    @if (!string.IsNullOrEmpty(GitHubEditUrl))
                    {
                        <a href="@GitHubEditUrl" target="_blank" rel="noopener" class="docs-footer-link">
                            <i class="bi bi-github me-1"></i> Edit on GitHub
                        </a>
                    }

                    <button class="docs-footer-link" @onclick="OpenSales">
                        <i class="bi bi-envelope me-1"></i> Contact sales
                    </button>
                </div>
            </main>
        </div>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public string PageTitle { get; set; } = "";
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? SectionUrl { get; set; }
    [Parameter] public string? GitHubEditUrl { get; set; }
    [Parameter] public string? HeaderHtml { get; set; }
    [Parameter] [EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private Task OpenSales()
    {
        return JS.InvokeVoidAsync("openSalesModal").AsTask();
    }

}