@* Components/Marketing/UseCaseGrid.razor *@
@using EmineoBlazor.Data

<div class="row g-4">
    @foreach (var uc in UseCases)
    {
        <div class="col-lg-4">
            <div class="ent-card h-100">
                <div class="ent-icon">@uc.Icon</div>
                <h4 class="h6 fw-bold mb-2">@uc.Title</h4>
                <p class="text-secondary small mb-0">@uc.Description</p>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public UseCase[] UseCases { get; set; } = [];
}