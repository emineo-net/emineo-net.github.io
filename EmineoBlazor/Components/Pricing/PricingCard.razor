@* Components/Pricing/PricingCard.razor *@

<div class="price-card @(Featured ? "featured" : null) d-flex flex-column">
    @if (Featured)
    {
        <div class="ribbon">@RibbonLabel</div>
    }

    <h3 class="h5 fw-bold mb-1">@Title</h3>
    <p class="text-secondary small mb-4" style="min-height: 40px;">@Description</p>

    <div class="mb-2">
        <span class="price-amount">@PriceAmount</span>
        @if (!string.IsNullOrEmpty(PriceSuffix))
        {
            <span class="text-secondary">@PriceSuffix</span>
        }
    </div>
    <p class="text-secondary small mb-4">@PriceNote</p>

    <ul class="feature-list flex-grow-1 pt-4 mb-4"
        style="border-top: 1px solid var(--bs-border-color);">
        @foreach (var f in Features)
        {
            <li class="@(f.Muted ? "muted" : null)">@f.Text</li>
        }
    </ul>

    <div class="mt-auto d-flex flex-column gap-2">
        @foreach (var cta in Ctas)
        {
            @if (cta.IsLink)
            {
                <a href="@cta.Href" target="@cta.Target" rel="@cta.Rel"
                   class="btn @cta.CssClass w-100">
                    @cta.Label
                </a>
            }
            else
            {
                <button class="btn @cta.CssClass w-100" @onclick="() => cta.OnClick.InvokeAsync()">
                    @cta.Label
                </button>
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(FooterNote))
    {
        <p class="sales-note">@FooterNote</p>
    }
</div>

@code {
    public sealed record FeatureItem(string Text, bool Muted = false);

    public sealed class CtaItem
    {
        public string Label { get; init; } = "";
        public string CssClass { get; init; } = "btn-brand";
        public bool IsLink { get; init; }
        public string Href { get; init; } = "";
        public string? Target { get; init; }
        public string? Rel { get; init; }
        public EventCallback OnClick { get; init; }
    }

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? RibbonLabel { get; set; }
    [Parameter] public bool Featured { get; set; }
    [Parameter, EditorRequired] public string PriceAmount { get; set; } = "";
    [Parameter] public string? PriceSuffix { get; set; }
    [Parameter] public string? PriceNote { get; set; }
    [Parameter, EditorRequired] public FeatureItem[] Features { get; set; } = [];
    [Parameter, EditorRequired] public CtaItem[] Ctas { get; set; } = [];
    [Parameter] public string? FooterNote { get; set; }
}