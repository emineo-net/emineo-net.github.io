@* Components/Layout/NavMenu.razor *@
@using Microsoft.AspNetCore.Components.Routing
@using SupabaseRcl.Components
@inject IJSRuntime JS

<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom sticky-top">
    <div class="container">

        <a class="navbar-brand fw-bold" href="" @onclick="Close">
            <span class="logo-dot"></span>
            Emineo
        </a>

        <button class="navbar-toggler" type="button"
                aria-controls="mainNav"
                aria-expanded="@isOpen.ToString().ToLower()"
                aria-label="Navigation umschalten"
                @onclick="Toggle">
            <span class="navbar-toggler-icon"></span>
        </button>

        @* "show" wird von Blazor gesetzt, dadurch braucht es kein Bootstrap-JavaScript *@
        <div class="collapse navbar-collapse @(isOpen ? "show" : null)" id="mainNav">

            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                @* ---- Products dropdown (Blazor-gesteuert, kein Bootstrap-JS) ---- *@
                <li class="nav-item dropdown @(isProductsOpen ? "show" : null)">
                    <a class="nav-link dropdown-toggle @(isProductsOpen ? "show" : null)"
                       href="#"
                       role="button"
                       aria-expanded="@isProductsOpen.ToString().ToLower()"
                       @onclick="ToggleProducts"
                       @onclick:preventDefault>
                        Products
                    </a>
                    <ul class="dropdown-menu @(isProductsOpen ? "show" : null)">
                        <li>
                            <a class="dropdown-item" href="/#resx" @onclick="CloseAll">
                                <strong>NetAI.ResxTranslator</strong>
                                <div class="small text-secondary">Fill missing translations automatically</div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/#unittest" @onclick="CloseAll">
                                <strong>NetAI.TestGenerator</strong>
                                <div class="small text-secondary">Generate unit tests with AI</div>
                            </a>
                        </li>
                    </ul>
                </li>

                @* ---- Marketing anchor links (start page) ---- *@
                <li class="nav-item">
                    <a class="nav-link" href="/#pricing" @onclick="Close">Pricing</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/#enterprise" @onclick="Close">Enterprise</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/#faq" @onclick="Close">FAQ</a>
                </li>

                @* ---- App routes (Blazor routing) ---- *@
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="Close">
                        Start
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="dashboard" @onclick="Close">
                        Dashboard
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="docs" @onclick="Close">
                        Docs
                    </NavLink>
                </li>
            </ul>

            @* ---- Auth status + CTA + theme toggle ---- *@
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <AuthStatus />

                <a href="/docs/getstarted" class="btn btn-brand" @onclick="Close">
                    Get Started
                </a>

                <button type="button"
                        class="theme-toggle"
                        @onclick="ToggleTheme"
                        title="@ThemeToggleTitle"
                        aria-label="@ThemeToggleTitle">
                    <span aria-hidden="true">@themeIcon</span>
                </button>
            </div>

        </div>
    </div>
</nav>

@code {
    private bool isOpen;
    private bool isProductsOpen;

    private string themeIcon = "☀️"; // will be corrected on first render

    private string ThemeToggleTitle =>
        themeIcon == "☀️" ? "Switch to light theme" : "Switch to dark theme";

    private void Toggle() => isOpen = !isOpen;

    private void ToggleProducts() => isProductsOpen = !isProductsOpen;

    private void Close()
    {
        isOpen = false;
        isProductsOpen = false;
    }

    private void CloseAll() => Close();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Read the theme that the inline script in index.html already applied.
        // Falls back gracefully if JS is unavailable.
        try
        {
            var theme = await JS.InvokeAsync<string>("emineoTheme.get");
            UpdateIcon(theme);
            StateHasChanged();
        }
        catch
        {
            // no-op: keep default icon
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JS.InvokeAsync<string>("emineoTheme.toggle");
            UpdateIcon(newTheme);
        }
        catch
        {
            // no-op
        }
    }

    private void UpdateIcon(string theme)
    {
        // Show the icon of the mode you'll switch TO.
        // Dark mode → sun (click to go light). Light mode → moon (click to go dark).
        themeIcon = theme == "dark" ? "☀️" : "🌙";
    }
}