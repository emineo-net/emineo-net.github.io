@* Layout/NavMenu.razor *@
@using Microsoft.AspNetCore.Components.Routing
@using EmineoBlazor.Data
@using SupabaseRcl.Components
@inject IJSRuntime JS

<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom sticky-top">
    <div class="container">

        <a class="navbar-brand fw-bold" href="" @onclick="Close">
            <span class="logo-dot"></span>
            Emineo
        </a>

        <button class="navbar-toggler" type="button"
                aria-controls="mainNav"
                aria-expanded="@isOpen.ToString().ToLower()"
                aria-label="Navigation umschalten"
                @onclick="Toggle">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse @(isOpen ? "show" : null)" id="mainNav">

            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                @* ---- Products dropdown (datengetrieben) ---- *@
                <li class="nav-item dropdown @(isProductsOpen ? "show" : null)">
                    <a class="nav-link dropdown-toggle @(isProductsOpen ? "show" : null)"
                       href="#" role="button"
                       aria-expanded="@isProductsOpen.ToString().ToLower()"
                       @onclick="ToggleProducts" @onclick:preventDefault>
                        Products
                    </a>
                    <ul class="dropdown-menu @(isProductsOpen ? "show" : null)">
                        @foreach (var product in Products.All)
                        {
                            <li>
                                <a class="dropdown-item" href="@product.ProductRoute" @onclick="CloseAll">
                                    <strong>@product.Name</strong>
                                    <div class="small text-secondary">@product.Tagline</div>
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="/products" @onclick="CloseAll">
                                <strong>All products</strong>
                                <div class="small text-secondary">Overview &amp; comparison</div>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="pricing" @onclick="Close">Pricing</NavLink>
                </li>
               

                @* ---- Docs dropdown ---- *@
                <li class="nav-item dropdown @(isDocsOpen ? "show" : null)">
                    <a class="nav-link dropdown-toggle @(isDocsOpen ? "show" : null)"
                       href="#" role="button"
                       aria-expanded="@isDocsOpen.ToString().ToLower()"
                       @onclick="ToggleDocs" @onclick:preventDefault>
                        Docs
                    </a>
                    <ul class="dropdown-menu @(isDocsOpen ? "show" : null)">
                        <li>
                            <a class="dropdown-item" href="/docs" @onclick="CloseAll">
                                <strong>Documentation hub</strong>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        @foreach (var product in Products.All)
                        {
                            <li>
                                <a class="dropdown-item" href="@product.DocsRoute" @onclick="CloseAll">
                                    @product.Name
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/docs/quickstart" @onclick="CloseAll">Quickstart</a></li>
                        <li><a class="dropdown-item" href="/docs/getstarted" @onclick="CloseAll">Get started</a></li>
                        <li><a class="dropdown-item" href="/changelog" @onclick="CloseAll">Changelog</a></li>
                    </ul>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="dashboard" @onclick="Close">Dashboard</NavLink>
                </li>
            </ul>

            @* ---- Auth status + CTA + theme toggle ---- *@
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <AuthStatus />

                <a href="/docs/getstarted" class="btn btn-brand" @onclick="Close">
                    Get Started
                </a>

                <button type="button" class="theme-toggle"
                        @onclick="ToggleTheme"
                        title="@ThemeToggleTitle"
                        aria-label="@ThemeToggleTitle">
                    <i class="bi @themeIcon" aria-hidden="true"></i>
                </button>
            </div>

        </div>
    </div>
</nav>

@code {
    private bool isOpen;
    private bool isProductsOpen;
    private bool isDocsOpen;

    // Bootstrap Icon class. Updated after first render and on every toggle.
    // Dark mode → sun (click to go light). Light mode → moon (click to go dark).
    private string themeIcon = "bi-sun";

    private string ThemeToggleTitle =>
        themeIcon == "bi-sun" ? "Switch to light theme" : "Switch to dark theme";

    private void Toggle() => isOpen = !isOpen;
    private void ToggleProducts() { isProductsOpen = !isProductsOpen; isDocsOpen = false; }
    private void ToggleDocs() { isDocsOpen = !isDocsOpen; isProductsOpen = false; }
    private void Close() { isOpen = false; isProductsOpen = false; isDocsOpen = false; }
    private void CloseAll() => Close();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var theme = await JS.InvokeAsync<string>("emineoTheme.get");
            UpdateIcon(theme);
            StateHasChanged();
        }
        catch { }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JS.InvokeAsync<string>("emineoTheme.toggle");
            UpdateIcon(newTheme);
        }
        catch { }
    }

    private void UpdateIcon(string theme) =>
        themeIcon = theme == "dark" ? "bi-sun" : "bi-moon-stars";
}