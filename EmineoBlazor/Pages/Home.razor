@page "/"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using EmineoBlazor.Components.Marketing
@using EmineoBlazor.Data
@using PaddleRcl.Services
@using SupabaseRcl.Services

@inject SupabaseService SupabaseService
@inject PaddlePortalService PortalService
@inject IJSRuntime JSRuntime

<PageTitle>Emineo â€“ AI tools for .NET teams</PageTitle>

@* ============ HERO (Marke) ============ *@
<header class="hero">
    <div class="container text-center">
        <div class="badge-soft mb-4 d-inline-block">
            <span class="dot"></span>
            New Â· v1.1 Â· MIT-licensed core
        </div>

        <h1 class="hero-title mb-4 mx-auto" style="max-width: 900px;">
            AI tools for .NET teams<br>
            who <span class="text-gradient">don't have time for boilerplate.</span>
        </h1>

        <p class="lead-muted mb-5 mx-auto" style="max-width: 680px;">
            Two NuGet packages. One philosophy: AI that runs inside your build,
            respects your conventions, and never leaves your machine unless you say so.
            MIT-licensed. Optional Enterprise support.
        </p>

        <div class="d-flex gap-3 justify-content-center flex-wrap mb-4">
            <a href="/products" class="btn btn-brand btn-lg-custom">Explore products</a>
            <a href="/pricing" class="btn btn-outline-brand btn-lg-custom">See pricing</a>
        </div>
    </div>
</header>

@* ============ AUTH / CUSTOMER BAR ============ *@
<AuthorizeView>
    <Authorized Context="auth">
        @{
            var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            var userEmail = auth.User.Identity?.Name ?? string.Empty;
        }

        <section class="bg-body-secondary py-3 border-bottom">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="small">
                        Welcome back, <strong>@auth.User.Identity?.Name</strong>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-outline-brand" @onclick="OpenCustomerPortal">
                            Manage subscription
                        </button>
                        <PaddleRcl.Checkout VendorToken="test_69e4846308930e14bac032aac4d"
                                            PriceId="pri_01m359hq9t1gmf3j4k7kbhycts"
                                            CustomerEmail="@userEmail"
                                            CustomerId="@userId"
                                            ButtonText="Activate Premium"
                                            Environment="sandbox"
                                            OnSuccess="HandlePaymentSuccess"
                                            OnClosed="HandleCheckoutClosed" />
                    </div>
                </div>
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        @* Landing page stays public â€” no login wall. *@
    </NotAuthorized>
</AuthorizeView>

@* ============ TRUST LOGOS ============ *@
<TrustStrip />

@* ============ HOW IT WORKS ============ *@
<HowItWorks />

@* ============ PRODUCTS OVERVIEW ============ *@
<section>
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">Products</span>
            <h2 class="display-custom mb-3">Two tools. Same engine.</h2>
            <p class="lead-muted mx-auto" style="max-width: 640px;">
                Both run during <code>dotnet build</code>, both speak to any OpenAI-compatible LLM,
                and both are MIT-licensed at the core.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var product in ProductCatalog.All)
            {
                <div class="col-lg-6">
                    <ProductCard Product="product" />
                </div>
            }
        </div>
    </div>
</section>

@* ============ WHY EMINEO ============ *@
<section class="bg-body-secondary">
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">Why Emineo</span>
            <h2 class="display-custom mb-3">Not another "prompt and pray" wrapper.</h2>
            <p class="lead-muted mx-auto" style="max-width: 640px;">
                The engine does the hard work before the LLM ever sees a prompt â€”
                so the output compiles, respects your conventions, and stays reviewable.
            </p>
        </div>

        <FeatureGrid Features="BrandFeatures" />
    </div>
</section>

@* ============ SHARE WITH TEAM LEAD ============ *@
<ShareWithTeamLead ProductName="Emineo"
                   PainPoint="repetitive .NET boilerplate â€” translations, test scaffolding, and the compliance paperwork that comes with every new tool"
                   ValueProposition="builds AI tools that run inside our existing build pipeline, keep code on-prem when we want it, and ship with the compliance paperwork already prepared" />

@* ============ ENTERPRISE TRUST ============ *@
<EnterpriseTrustBar />

@* ============ FAQ ============ *@
<section>
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">FAQ</span>
            <h2 class="display-custom mb-3">The questions that come up first.</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <FaqAccordion Items="@Faqs.General" AccordionId="faqHome" />
            </div>
        </div>
    </div>
</section>

@* ============ FINAL CTA ============ *@
<section>
    <div class="container">
        <div class="ent-cta-bar text-center">
            <h3 class="h4 fw-bold mb-2">Questions about security, contracts, or onboarding?</h3>
            <p class="text-secondary mb-4">
                We get back to you within one business day â€” with concrete answers, not marketing.
            </p>
            <button class="btn btn-brand btn-lg-custom" @onclick='() => ContactSales("General")'>
                Contact sales â†’
            </button>
        </div>
    </div>
</section>

