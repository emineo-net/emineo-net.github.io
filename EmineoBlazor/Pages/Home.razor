@page "/"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PaddleRcl.Services
@using SupabaseRcl.Services
@inject SupabaseService SupabaseService
@inject PaddlePortalService PortalService
@inject IJSRuntime JSRuntime


<PageTitle>Emineo – AI Tools for .NET Teams</PageTitle>

@* ============ HERO ============ *@
<header class="hero">
    <div class="container text-center">
        <div class="badge-soft mb-4 d-inline-block">
            <span class="dot"></span>
            New · v1.0 available
        </div>

        <h1 class="hero-title mb-4 mx-auto" style="max-width: 900px;">
            AI tools for .NET teams<br>
            who <span class="text-gradient">don't have time for boilerplate.</span>
        </h1>

        <p class="lead-muted mb-5 mx-auto" style="max-width: 640px;">
            Translations. Tests. Run locally via Ollama or with your own API key.
            Shipped as NuGet packages, MIT-licensed, with optional Enterprise support.
        </p>

        <div class="d-flex gap-3 justify-content-center flex-wrap mb-4">
            <a href="#pricing" class="btn btn-brand btn-lg-custom">Start for free</a>
            <a href="#resx" class="btn btn-outline-brand btn-lg-custom">See products</a>
        </div>

        <div class="code-pill">dotnet add package Emineo.ResXTranslator</div>
    </div>
</header>


@* ============ AUTHENTICATION ============ *@
<section id="authentication" class="bg-body-secondary">
    <div class="container">
        <AuthorizeView>
            <Authorized>
                <h3>Willkommen zurück, @context.User.Identity?.Name!</h3>

                <button @onclick="OpenCustomerPortal">Abo verwalten</button>

                <p>Dieser Inhalt ist streng geheim.</p>

                @{
                    var userId = context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
                    var userEmail = context.User.Identity?.Name ?? string.Empty;
                }

                <PaddleRcl.Checkout VendorToken="test_69e4846308930e14bac032aac4d"
                                    PriceId="pri_01m359hq9t1gmf3j4k7kbhycts"
                                    CustomerEmail="@userEmail"
                                    CustomerId="@userId"
                                    ButtonText="Premium aktivieren"
                                    Environment="sandbox"
                                    OnSuccess="HandlePaymentSuccess"
                                    OnClosed="HandleCheckoutClosed" />
            </Authorized>
            <NotAuthorized>
                <h3>Halt!</h3>
                <p>Bitte logge dich zuerst ein.</p>
                @* <SupabaseRcl.Components.Login /> *@
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>


@* ============ TRUST LOGOS ============ *@
<div class="trust-strip">
    <div class="container text-center">
        <p class="text-uppercase small fw-semibold text-secondary mb-4" style="letter-spacing: 0.1em;">
            Trusted by developer teams &amp; enterprises
        </p>
        @* PLACEHOLDER: replace .logo-slot with <img> once you have customer logos *@
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <div class="logo-slot">LOGO 1</div>
            <div class="logo-slot">LOGO 2</div>
            <div class="logo-slot">LOGO 3</div>
            <div class="logo-slot">LOGO 4</div>
            <div class="logo-slot">LOGO 5</div>
        </div>
    </div>
</div>


@* ============ A) HOW IT WORKS ============ *@
<section id="how-it-works" class="bg-body-secondary">
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">How it works</span>
            <h2 class="display-custom mb-3">From config to committed in three steps.</h2>
            <p class="lead-muted mx-auto" style="max-width: 620px;">
                No dashboards to log into, no pipelines to rebuild.
                Drop it in, run it, review the diff like any other PR.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="ent-card text-center h-100">
                    <div class="ent-icon mx-auto fw-bold" style="font-size: 1.15rem;">01</div>
                    <h3 class="h5 fw-bold mb-2">Configure</h3>
                    <p class="text-secondary small mb-0">
                        Drop a <code>resx.config.json</code> or <code>unittest.config.json</code>
                        into your repo. Pick your AI provider – Ollama locally, or a cloud API key.
                        Set languages, framework, and naming conventions.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card text-center h-100">
                    <div class="ent-icon mx-auto fw-bold" style="font-size: 1.15rem;">02</div>
                    <h3 class="h5 fw-bold mb-2">Scan</h3>
                    <p class="text-secondary small mb-0">
                        The tool walks your solution, detects missing translations
                        or untested methods, and produces a report. You see exactly
                        what would change before anything is written.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card text-center h-100">
                    <div class="ent-icon mx-auto fw-bold" style="font-size: 1.15rem;">03</div>
                    <h3 class="h5 fw-bold mb-2">Generate</h3>
                    <p class="text-secondary small mb-0">
                        Run from the CLI, MSBuild, or your CI pipeline.
                        The AI fills the gaps, placeholders stay intact, and your team
                        reviews the change like any other PR.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


@* ============ RESX TRANSLATOR ============ *@
<section id="resx">
    <div class="container">
        <div class="row align-items-center g-5 py-4">
            <div class="col-lg-6">
                <span class="eyebrow d-block mb-3">ResX AI Translator</span>
                <h2 class="fw-bold mb-3" style="letter-spacing:-0.02em;">
                    No more "TODO: translate" in your .resx files.
                </h2>
                <p class="mb-3">
                    Scans your resource files for missing translations and fills them in automatically –
                    using your AI model, your languages, your rules.
                </p>
                <p class="text-secondary mb-4">
                    Every .NET localization eventually hits the same wall: new keys in English, empty
                    <code class="text-info">.de.resx</code>, and someone copies the English text just to make
                    it compile. ResX AI Translator cleans that up – with your own API key, or entirely
                    local via Ollama.
                </p>

                <ul class="row row-cols-1 row-cols-md-2 g-2 mb-4 list-unstyled">
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>Detect missing keys automatically</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>API key or local Ollama</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>Multiple target languages in parallel</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>Placeholders stay intact</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>JSON-based configuration</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>CLI + MSBuild integration</li>
                </ul>

                @* D) Deep-dive link *@
                <div class="d-flex gap-2 flex-wrap">
                    <a href="#pricing" class="btn btn-brand btn-lg-custom">Choose a license →</a>
                    <a href="/products/resx-translator" class="btn btn-outline-brand btn-lg-custom">
                        Read the deep dive →
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="product-visual">
                    <div class="terminal-head"><span></span><span></span><span></span></div>
                    <pre><span class="c">// resx.config.json</span>
{
  <span class="k">"provider"</span>: <span class="s">"ollama"</span>,
  <span class="k">"model"</span>: <span class="s">"llama3.1:8b"</span>,
  <span class="k">"baseCulture"</span>: <span class="s">"en"</span>,
  <span class="k">"targetCultures"</span>: [<span class="s">"de"</span>, <span class="s">"fr"</span>, <span class="s">"es"</span>, <span class="s">"it"</span>],
  <span class="k">"preservePlaceholders"</span>: <span class="b">true</span>,
  <span class="k">"glossary"</span>: {
    <span class="k">"Login"</span>: <span class="s">"Anmeldung"</span>
  }
}</pre>
                </div>
            </div>
        </div>

        @* ============ B) BEFORE / AFTER – RESX ============ *@
        <div class="row g-4 mt-5 pt-5" style="border-top: 1px solid var(--bs-border-color);">
            <div class="col-12 mb-2">
                <span class="eyebrow d-block">Before / After</span>
                <h3 class="h4 fw-bold mt-2">What it actually does to your files.</h3>
            </div>

            <div class="col-lg-6">
                <p class="eyebrow mb-2">Before · locales/Strings.de.resx</p>
                <div class="product-visual">
                    <div class="terminal-head"><span></span><span></span><span></span></div>
<pre><span class="c">&lt;!-- 47 keys · 12 untranslated --&gt;</span>
&lt;<span class="k">data</span> name=<span class="s">"Login_Title"</span>&gt;
  &lt;<span class="k">value</span>&gt;Sign in to your account&lt;/<span class="k">value</span>&gt;
&lt;/<span class="k">data</span>&gt;
&lt;<span class="k">data</span> name=<span class="s">"Login_Email"</span>&gt;
  &lt;<span class="k">value</span>&gt;Email&lt;/<span class="k">value</span>&gt;
&lt;/<span class="k">data</span>&gt;
&lt;<span class="k">data</span> name=<span class="s">"Login_Password"</span>&gt;
  &lt;<span class="k">value</span>&gt;Password&lt;/<span class="k">value</span>&gt;
&lt;/<span class="k">data</span>&gt;
<span class="c">// ⚠️ 12 entries still in English</span></pre>
                </div>
            </div>

            <div class="col-lg-6">
                <p class="eyebrow mb-2">After · dotnet resx-translate fill</p>
                <div class="product-visual">
                    <div class="terminal-head"><span></span><span></span><span></span></div>
<pre><span class="c">&lt;!-- 47 keys · 0 untranslated --&gt;</span>
&lt;<span class="k">data</span> name=<span class="s">"Login_Title"</span>&gt;
  &lt;<span class="k">value</span>&gt;Bei Ihrem Konto anmelden&lt;/<span class="k">value</span>&gt;
&lt;/<span class="k">data</span>&gt;
&lt;<span class="k">data</span> name=<span class="s">"Login_Email"</span>&gt;
  &lt;<span class="k">value</span>&gt;E-Mail-Adresse&lt;/<span class="k">value</span>&gt;
&lt;/<span class="k">data</span>&gt;
&lt;<span class="k">data</span> name=<span class="s">"Login_Password"</span>&gt;
  &lt;<span class="k">value</span>&gt;Passwort&lt;/<span class="k">value</span>&gt;
&lt;/<span class="k">data</span>&gt;
<span class="c">// ✅ Translated via Ollama · llama3.1:8b</span></pre>
                </div>
            </div>
        </div>

        @* ============ B) USE CASES – RESX ============ *@
        <div class="row g-4 mt-4">
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon">🌍</div>
                    <h4 class="h6 fw-bold mb-2">Multi-tenant SaaS</h4>
                    <p class="text-secondary small mb-0">
                        Ship in 12 languages without a dedicated localization team.
                        New keys land in every culture before the PR is merged.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon">🧹</div>
                    <h4 class="h6 fw-bold mb-2">Legacy .NET migrations</h4>
                    <p class="text-secondary small mb-0">
                        Years of "TODO: translate" cleared in one pass.
                        Audit reports show exactly what changed per culture.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon">🔐</div>
                    <h4 class="h6 fw-bold mb-2">Regulated &amp; air-gapped</h4>
                    <p class="text-secondary small mb-0">
                        Run Ollama inside your network. Nothing leaves the machine,
                        no cloud vendor ever sees your strings.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


@* ============ UNITTEST GENERATOR ============ *@
<section id="unittest" class="bg-body-secondary">
    <div class="container">
        <div class="row align-items-center g-5 py-4 flex-lg-row-reverse">
            <div class="col-lg-6">
                <span class="eyebrow d-block mb-3">UnitTest AI Generator</span>
                <h2 class="fw-bold mb-3" style="letter-spacing:-0.02em;">
                    Your tests won't write themselves. But almost.
                </h2>
                <p class="mb-3">
                    Analyzes your classes and methods and generates matching unit tests –
                    with xUnit, NUnit, or MSTest. Your model, your conventions.
                </p>
                <p class="text-secondary mb-4">
                    Test coverage matters – but nobody enjoys writing 400 test methods by hand.
                    The generator understands signatures, dependencies, and edge cases, and produces
                    runnable tests in your framework of choice.
                </p>

                <ul class="row row-cols-1 row-cols-md-2 g-2 mb-4 list-unstyled">
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>Auto-tests for all methods</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>xUnit, NUnit, MSTest</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>Moq / NSubstitute / FakeItEasy</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>API key or local Ollama</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>Arrange-Act-Assert structure</li>
                    <li class="col d-flex gap-2"><i class="bi bi-check-lg text-success"></i>JSON-based configuration</li>
                </ul>

                @* D) Deep-dive link *@
                <div class="d-flex gap-2 flex-wrap">
                    <a href="#pricing" class="btn btn-brand btn-lg-custom">Choose a license →</a>
                    <a href="/products/unittest-generator" class="btn btn-outline-brand btn-lg-custom">
                        Read the deep dive →
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="product-visual">
                    <div class="terminal-head"><span></span><span></span><span></span></div>
                    <pre><span class="c">// unittest.config.json</span>
{
  <span class="k">"provider"</span>: <span class="s">"openai"</span>,
  <span class="k">"model"</span>: <span class="s">"gpt-4o-mini"</span>,
  <span class="k">"framework"</span>: <span class="s">"xunit"</span>,
  <span class="k">"mockingLibrary"</span>: <span class="s">"moq"</span>,
  <span class="k">"testProjectSuffix"</span>: <span class="s">".Tests"</span>,
  <span class="k">"coverageGoal"</span>: <span class="b">80</span>,
  <span class="k">"namingConvention"</span>:
    <span class="s">"MethodName_Scenario_ExpectedResult"</span>
}</pre>
                </div>
            </div>
        </div>

        @* ============ B) BEFORE / AFTER – UNITTEST ============ *@
        <div class="row g-4 mt-5 pt-5" style="border-top: 1px solid var(--bs-border-color);">
            <div class="col-12 mb-2">
                <span class="eyebrow d-block">Before / After</span>
                <h3 class="h4 fw-bold mt-2">From empty shell to real coverage.</h3>
            </div>

            <div class="col-lg-6">
                <p class="eyebrow mb-2">Before · Services/InvoiceServiceTests.cs</p>
                <div class="product-visual">
                    <div class="terminal-head"><span></span><span></span><span></span></div>
<pre><span class="c">// 0 tests · 14 methods untested</span>
<span class="k">public class</span> <span class="b">InvoiceServiceTests</span>
{
    <span class="c">// TODO: write tests</span>
}
<span class="c">// ⚠️ Coverage: 0%</span></pre>
                </div>
            </div>

            <div class="col-lg-6">
                <p class="eyebrow mb-2">After · dotnet unittest-generate</p>
                <div class="product-visual">
                    <div class="terminal-head"><span></span><span></span><span></span></div>
<pre><span class="c">// 14 tests · coverage 82%</span>
[<span class="b">Fact</span>]
<span class="k">public void</span> <span class="b">CalculateTotal_WithTax_ReturnsGross</span>()
{
    <span class="k">var</span> svc = <span class="k">new</span> <span class="b">InvoiceService</span>();
    <span class="k">var</span> result = svc.CalculateTotal(<span class="b">100m</span>, <span class="b">0.19m</span>);
    Assert.Equal(<span class="b">119m</span>, result);
}

[<span class="b">Fact</span>]
<span class="k">public void</span> <span class="b">CalculateTotal_Negative_Throws</span>()
{
    <span class="k">var</span> svc = <span class="k">new</span> <span class="b">InvoiceService</span>();
    Assert.Throws&lt;<span class="b">ArgumentOutOfRangeException</span>&gt;(
        () =&gt; svc.CalculateTotal(<span class="b">-1m</span>, <span class="b">0.19m</span>));
}
<span class="c">// ✅ Generated via OpenAI · gpt-4o-mini</span></pre>
                </div>
            </div>
        </div>

        @* ============ B) USE CASES – UNITTEST ============ *@
        <div class="row g-4 mt-4">
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon">📈</div>
                    <h4 class="h6 fw-bold mb-2">Legacy coverage rescue</h4>
                    <p class="text-secondary small mb-0">
                        Take a project from 12% to 80% coverage without
                        hand-writing hundreds of test methods.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon">🚦</div>
                    <h4 class="h6 fw-bold mb-2">CI quality gates</h4>
                    <p class="text-secondary small mb-0">
                        Fail the build when coverage drops or when new methods
                        ship without tests. Zero-tolerance, zero-effort.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon">📚</div>
                    <h4 class="h6 fw-bold mb-2">Onboarding &amp; docs</h4>
                    <p class="text-secondary small mb-0">
                        Generated tests double as executable documentation –
                        new team members see exactly how the code is meant to be used.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


