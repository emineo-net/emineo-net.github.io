@page "/docs/quickstart"

<PageTitle>Quickstart – Emineo Documentation</PageTitle>

<header class="hero">
    <div class="container text-center">
        <div class="badge-soft mb-4 d-inline-block">
            <span class="dot"></span>
            Five minutes, two builds, zero dashboards
        </div>
        <h1 class="hero-title mb-4 mx-auto" style="max-width: 900px;">
            From <code>dotnet add package</code><br>
            <span class="text-gradient">to committed in one build.</span>
        </h1>
        <p class="lead-muted mb-0 mx-auto" style="max-width: 680px;">
            Same workflow for both products. Pick one (or both), install, build once to scaffold
            the config, point it at your LLM, build again.
        </p>
    </div>
</header>

<section>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="docs-step">
                    <div class="docs-step-num">1</div>
                    <div class="docs-step-body">
                        <h3 class="h5 fw-bold mb-2">Install the package</h3>
                        <p class="text-secondary small mb-3">
                            Pick the product that fits (or install both). Each NuGet package injects
                            its own <code>.targets</code> file automatically.
                        </p>

                        <p class="docs-step-label">NetAI.ResxTranslator</p>
                        <pre class="docs-code"><code>dotnet add package NetAI.ResxTranslator.Tasks</code></pre>

                        <p class="docs-step-label">NetAI.TestGenerator</p>
                        <pre class="docs-code"><code>dotnet add package NetAI.TestGenerator.Tasks</code></pre>
                    </div>
                </div>

                <div class="docs-step">
                    <div class="docs-step-num">2</div>
                    <div class="docs-step-body">
                        <h3 class="h5 fw-bold mb-2">Build once — the config scaffolds itself</h3>
                        <p class="text-secondary small mb-3">
                            On the first build, two files land in your project root if they don't exist.
                            <strong>Commit both.</strong>
                        </p>

                        <ul class="docs-prereq-list">
                            <li><code>aisettings.json</code> — your configuration file</li>
                            <li><code>aisettings-schema.json</code> — JSON Schema for editor IntelliSense</li>
                        </ul>

                        <pre class="docs-code"><code>dotnet build</code></pre>
                    </div>
                </div>

                <div class="docs-step">
                    <div class="docs-step-num">3</div>
                    <div class="docs-step-body">
                        <h3 class="h5 fw-bold mb-2">Point it at your LLM</h3>
                        <p class="text-secondary small mb-3">
                            Edit the <code>aiConfiguration</code> block. Local or cloud — same fields.
                        </p>

                        <p class="docs-step-label">Ollama + Qwen 2.5 14B (local, no API key)</p>
                        <pre class="docs-code"><code>{
  "$schema": "aisettings-schema.json",
  "version": "1.1",
  "aiConfiguration": {
    "baseUrl": "http://localhost:11434/",
    "model": "qwen2.5:14b",
    "temperature": 0.2,
    "timeoutMinutes": 10
  }
}</code></pre>

                        <p class="docs-step-label">OpenAI (cloud, key via env var)</p>
                        <pre class="docs-code"><code>{
  "$schema": "aisettings-schema.json",
  "version": "1.1",
  "aiConfiguration": {
    "baseUrl": "https://api.openai.com/",
    "model": "gpt-4o",
    "temperature": 0.2,
    "timeoutMinutes": 5,
    "apiKeyEnvVar": "OPENAI_API_KEY"
  }
}</code></pre>

                        <div class="docs-callout mt-3">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-exclamation-triangle docs-callout-icon"></i>
                                <div>
                                    <strong class="d-block mb-1">Trailing slash required</strong>
                                    <p class="mb-0 text-secondary small">
                                        <code>http://localhost:11434</code> is invalid;
                                        <code>http://localhost:11434/</code> is correct.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="docs-step">
                    <div class="docs-step-num">4</div>
                    <div class="docs-step-body">
                        <h3 class="h5 fw-bold mb-2">Build again — the magic happens</h3>
                        <p class="text-secondary small mb-3">
                            During this build, the task runs before compilation. Missing translations
                            or missing test skeletons are filled in, validated, and written to your
                            project. Review the diff like any other PR.
                        </p>

                        <pre class="docs-code"><code>dotnet build</code></pre>
                    </div>
                </div>

                <div class="docs-step">
                    <div class="docs-step-num">5</div>
                    <div class="docs-step-body">
                        <h3 class="h5 fw-bold mb-2">Tune the behavior</h3>
                        <p class="text-secondary small mb-3">
                            Per-project MSBuild properties. All optional, all default to sensible values.
                        </p>

                        <p class="docs-step-label">TestGenerator</p>
                        <pre class="docs-code"><code>&lt;PropertyGroup&gt;
  &lt;TestGeneratorEnabled&gt;true&lt;/TestGeneratorEnabled&gt;
  &lt;TestGeneratorSemanticAnalysisEnabled&gt;true&lt;/TestGeneratorSemanticAnalysisEnabled&gt;
  &lt;TestGeneratorPromptOnly&gt;false&lt;/TestGeneratorPromptOnly&gt;
  &lt;TestGeneratorFailOnError&gt;false&lt;/TestGeneratorFailOnError&gt;
&lt;/PropertyGroup&gt;</code></pre>

                        <p class="docs-step-label">ResxTranslator</p>
                        <pre class="docs-code"><code>&lt;PropertyGroup&gt;
  &lt;ResxTranslatorEnabled&gt;true&lt;/ResxTranslatorEnabled&gt;
&lt;/PropertyGroup&gt;</code></pre>

                        <p class="text-secondary small mb-0 mt-3">
                            Per invocation: <code>dotnet build -p:TestGeneratorPromptOnly=true</code>.
                        </p>
                    </div>
                </div>

                <div class="docs-callout mt-5">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle docs-callout-icon"></i>
                        <div>
                            <h4 class="h6 fw-bold mb-2">Next: product-specific deep dives</h4>
                            <p class="mb-3 text-secondary small">
                                The pages below cover the CLI, advanced configuration, troubleshooting,
                                and everything you need for CI/CD.
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="/docs/resx-translator" class="btn btn-outline-brand btn-sm">
                                    ResxTranslator docs
                                </a>
                                <a href="/docs/test-generator" class="btn btn-outline-brand btn-sm">
                                    TestGenerator docs
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>