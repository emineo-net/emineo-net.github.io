@page "/docs/getstarted"

<PageTitle>Get started – Emineo Documentation</PageTitle>

<header class="hero">
    <div class="container text-center">
        <div class="badge-soft mb-4 d-inline-block">
            <span class="dot"></span>
            Which product for me?
        </div>
        <h1 class="hero-title mb-4 mx-auto" style="max-width: 900px;">
            Two questions. One clear answer.<br>
            <span class="text-gradient">Then you're set up.</span>
        </h1>
        <p class="lead-muted mb-0 mx-auto" style="max-width: 680px;">
            Both products run during <code>dotnet build</code>, both speak to any OpenAI-compatible
            LLM, and both use the same <code>aisettings.json</code>. The only difference is <em>what</em>
            they automate.
        </p>
    </div>
</header>

<section>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="docs-decision-grid">
                    <div class="docs-decision-card">
                        <div class="ent-icon">
                            <i class="bi bi-globe"></i>
                        </div>
                        <h3 class="h5 fw-bold mb-2">You ship multi-language software</h3>
                        <p class="text-secondary small mb-3">
                            Your team has English keys, empty <code>.de.resx</code> files, and someone
                            keeps copy-pasting English to make the build pass.
                        </p>
                        <p class="fw-bold mb-2">Use NetAI.ResxTranslator.</p>
                        <a href="/docs/resx-translator" class="btn btn-brand btn-sm">
                            Open the ResxTranslator docs →
                        </a>
                    </div>

                    <div class="docs-decision-card">
                        <div class="ent-icon">
                            <i class="bi bi-eyedropper"></i>
                        </div>
                        <h3 class="h5 fw-bold mb-2">You want more test coverage</h3>
                        <p class="text-secondary small mb-3">
                            You keep missing coverage gates, hand-writing test scaffolding, and
                            know the AI tools out there hallucinate types.
                        </p>
                        <p class="fw-bold mb-2">Use NetAI.TestGenerator.</p>
                        <a href="/docs/test-generator" class="btn btn-brand btn-sm">
                            Open the TestGenerator docs →
                        </a>
                    </div>
                </div>

                <div class="docs-callout mt-5">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-lightbulb docs-callout-icon"></i>
                        <div>
                            <h4 class="h6 fw-bold mb-2">Both?</h4>
                            <p class="mb-2 text-secondary small">
                                They're independent NuGet packages, so you can install them side by side
                                and share the same <code>aisettings.json</code>.
                            </p>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<section class="bg-body-secondary">
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">Shared foundation</span>
            <h2 class="display-custom mb-3">What both products have in common.</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="ent-card h-100">
                    <div class="ent-icon">
                        <i class="bi bi-filetype-json"></i>
                    </div>
                    <h4 class="h6 fw-bold mb-2">One config file</h4>
                    <p class="text-secondary small mb-0">
                        <code>aisettings.json</code> at the project root — with full JSON Schema
                        validation in VS, Rider, and VS Code.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ent-card h-100">
                    <div class="ent-icon">
                        <i class="bi bi-house"></i>
                    </div>
                    <h4 class="h6 fw-bold mb-2">Local-first</h4>
                    <p class="text-secondary small mb-0">
                        Ollama, LM Studio, llama.cpp, or the companion LLMRunner app.
                        Cloud APIs are optional.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ent-card h-100">
                    <div class="ent-icon">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h4 class="h6 fw-bold mb-2">MSBuild-native</h4>
                    <p class="text-secondary small mb-0">
                        Runs during <code>dotnet build</code>. Design-time skipped, WPF-safe,
                        multi-targeting aware.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ent-card h-100">
                    <div class="ent-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="h6 fw-bold mb-2">MIT core</h4>
                    <p class="text-secondary small mb-0">
                        Free forever, commercial use allowed.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="docs-prereq">
                    <h3 class="h5 fw-bold mb-4">Before you install anything</h3>

                    <div class="docs-prereq-item">
                        <span class="docs-prereq-num">1</span>
                        <div>
                            <strong>.NET SDK 10.0 or later</strong>
                            <p class="text-secondary small mb-0">
                                The task itself runs on <code>netstandard2.0</code> inside MSBuild's
                                runtime, so any modern host project works.
                            </p>
                        </div>
                    </div>

                    <div class="docs-prereq-item">
                        <span class="docs-prereq-num">2</span>
                        <div>
                            <strong>A .sln or .slnx file</strong>
                            <p class="text-secondary small mb-0">
                                The task searches upward from your project directory to place the test
                                project. It stops at the first match.
                            </p>
                        </div>
                    </div>

                    <div class="docs-prereq-item">
                        <span class="docs-prereq-num">3</span>
                        <div>
                            <strong>An OpenAI-compatible LLM endpoint</strong>
                            <p class="text-secondary small mb-2">
                                Three ways to get one:
                            </p>
                            <ul class="docs-prereq-list">
                                <li>
                                    <strong>LLMRunner</strong> (recommended) — the companion WPF app
                                    from the same authors. Pick a model, click <em>Serve</em>, done.
                                    Serves on <code>http://localhost:8080/</code> — exactly what
                                    <code>aisettings.json</code> expects.
                                </li>
                                <li>
                                    <strong>Ollama</strong> — <code>ollama pull qwen2.5:14b</code> then
                                    <code>ollama serve</code>. Listens on <code>http://localhost:11434/</code>.
                                </li>
                                <li>
                                    <strong>Hosted</strong> — OpenAI, Azure OpenAI, or any gateway
                                    exposing <code>/v1/chat/completions</code>.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-5">
                    <a href="/docs/quickstart" class="btn btn-brand btn-lg-custom">
                        Continue to Quickstart →
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>