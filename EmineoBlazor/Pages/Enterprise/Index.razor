@page "/enterprise"
@using EmineoBlazor.Components.Marketing
@using EmineoBlazor.Data

<PageTitle>Enterprise – Emineo</PageTitle>

<header class="hero">
    <div class="container text-center">
        <div class="badge-soft mb-4 d-inline-block">
            <span class="dot"></span>
            GDPR · DPA · MSA · PO · SLA
        </div>
        <h1 class="hero-title mb-4 mx-auto" style="max-width: 900px;">
            Built for teams that take<br>
            <span class="text-gradient">compliance seriously.</span>
        </h1>
        <p class="lead-muted mx-auto" style="max-width: 680px;">
            Your code, your data, your rules. We provide the tooling — you stay in control.
            Everything procurement, legal, and IT want before sign-off.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap mt-4">
            <button class="btn btn-brand btn-lg-custom" @onclick="OpenSales">
                Talk to sales →
            </button>
            <a href="/legal/dpa" class="btn btn-outline-brand btn-lg-custom">
                Read the DPA template
            </a>
        </div>
    </div>
</header>

<section>
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">Data residency</span>
            <h2 class="display-custom mb-3">Three deployment modes. You choose.</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-house"></i></div>
                    <h3 class="h5 fw-bold mb-2">Local (Ollama)</h3>
                    <p class="text-secondary small mb-3">
                        Code and strings stay entirely on your machine or server.
                    </p>
                    <ul class="ent-list">
                        <li><strong>Network</strong> Zero external calls</li>
                        <li><strong>Region</strong> On-prem, air-gapped, EU</li>
                        <li><strong>Telemetry</strong> None</li>
                        <li><strong>Best for</strong> Regulated industries</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-cloud"></i></div>
                    <h3 class="h5 fw-bold mb-2">Cloud with your key</h3>
                    <p class="text-secondary small mb-3">
                        Requests go directly from your machine to your AI provider.
                    </p>
                    <ul class="ent-list">
                        <li><strong>Providers</strong> OpenAI, Azure EU, Anthropic</li>
                        <li><strong>Billing</strong> Through your existing contract</li>
                        <li><strong>We see</strong> Nothing</li>
                        <li><strong>Best for</strong> Frontier models, no MLOps</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-shuffle"></i></div>
                    <h3 class="h5 fw-bold mb-2">Hybrid</h3>
                    <p class="text-secondary small mb-3">
                        Sensitive resources locally, non-critical ones in the cloud.
                    </p>
                    <ul class="ent-list">
                        <li><strong>Config</strong> Per project or per file</li>
                        <li><strong>Policy</strong> Enforced at build time</li>
                        <li><strong>Fallback</strong> Local model if cloud unreachable</li>
                        <li><strong>Best for</strong> Mixed workloads</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-body-secondary">
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">Compliance &amp; contracts</span>
            <h2 class="display-custom mb-3">The paperwork, already prepared.</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-shield-check"></i></div>
                    <h3 class="h6 fw-bold mb-2">DPA (GDPR Art. 28)</h3>
                    <p class="text-secondary small mb-0">
                        Available on request. On-prem deployments often don't require one at all.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-file-text"></i></div>
                    <h3 class="h6 fw-bold mb-2">MSA &amp; NDA</h3>
                    <p class="text-secondary small mb-0">
                        Individual Master Service Agreements. NDAs welcome. Custom contracts possible.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-receipt"></i></div>
                    <h3 class="h6 fw-bold mb-2">PO &amp; VAT invoice</h3>
                    <p class="text-secondary small mb-0">
                        Standard invoices with VAT, PO number, and 30-day net payment terms.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-bullseye"></i></div>
                    <h3 class="h6 fw-bold mb-2">ISO 27001 (in progress)</h3>
                    <p class="text-secondary small mb-0">
                        Certification underway. Status updates on request.
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/legal/subprocessors" class="btn btn-outline-brand">
                See the full subprocessor list →
            </a>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">Support &amp; SLA</span>
            <h2 class="display-custom mb-3">A direct line to the team.</h2>
            <p class="lead-muted mx-auto" style="max-width: 640px;">
                No ticket roulette. No offshore handoffs. Email, Slack Connect, and video.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-lightning-charge"></i></div>
                    <h3 class="h5 fw-bold mb-2">Response within 8h</h3>
                    <p class="text-secondary small mb-0">
                        Business days, business hours. Priority support with an SLA on Enterprise licenses.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-people"></i></div>
                    <h3 class="h5 fw-bold mb-2">1:1 onboarding</h3>
                    <p class="text-secondary small mb-0">
                        A live onboarding session is included. We get your team from zero to first build in one call.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ent-card h-100">
                    <div class="ent-icon"><i class="bi bi-arrow-repeat"></i></div>
                    <h3 class="h5 fw-bold mb-2">All updates</h3>
                    <p class="text-secondary small mb-0">
                        Every major and minor release while your Enterprise license is active.
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/legal/sla" class="btn btn-outline-brand">
                Read the full SLA →
            </a>
        </div>
    </div>
</section>

<section class="bg-body-secondary">
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">FAQ for procurement &amp; IT</span>
            <h2 class="display-custom mb-3">The questions that come up before the order.</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <FaqAccordion Items="@Faqs.Enterprise" AccordionId="faqEnterprise" />
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="ent-cta-bar text-center">
            <h3 class="h4 fw-bold mb-2">Questions about security, contracts, or onboarding?</h3>
            <p class="text-secondary mb-4">
                We get back to you within one business day — with concrete answers, not marketing.
            </p>
            <button class="btn btn-brand btn-lg-custom" @onclick="OpenSales">
                Contact sales →
            </button>
        </div>
    </div>
</section>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private Task OpenSales() => JS.InvokeVoidAsync("openSalesModal").AsTask();
}