@page "/products/resx-translator"

<PageTitle>NetAI.ResxTranslator â€“ AI-powered .resx localization</PageTitle>

@{
    var p = ProductCatalog.ResxTranslator;
}

<ProductHero Product="p"
             Badge="MIT-licensed - NuGet - MSBuild-ready"
             HeadlineHtml="No more hand-translating .resx files. <span class=&quot;text-gradient&quot;>Fills itself in during build.</span>"
             SubLead="@@p.Description Run locally via Ollama or with your own API key. Shipped as a NuGet package."/>

<section>
    <div class="container">
        <div class="row align-items-center g-5 py-4">
            <div class="col-lg-6">
                <span class="eyebrow d-block mb-3">@p.Name</span>
                <h2 class="fw-bold mb-3">Fills every gap — in your languages, with your model.</h2>
                <p class="mb-4 text-secondary">
                    Every .NET localization eventually hits the same wall: new keys in English, empty
                    <code>.de.resx</code>, and someone copies the English text just to make it compile.
                    NetAI.ResxTranslator cleans that up â€” with your own API key or entirely local via Ollama.
                </p>

                <ul class="row row-cols-1 row-cols-md-2 g-2 mb-4 list-unstyled">
                    @foreach (var win in p.QuickWins)
                    {
                        <li class="col d-flex gap-2">
                            <i class="bi bi-check-lg text-success"></i>@win
                        </li>
                    }
                </ul>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="@p.DocsRoute" class="btn btn-outline-brand btn-lg-custom">
                        Read the docs â†’
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <CodeTerminal Label="aisettings.json" Html="@AisettingsHtml"/>
            </div>
        </div>
    </div>
</section>

<BeforeAfter Heading="What it actually does to your files."
             BeforeLabel="Before - locales/Strings.de.resx"
             BeforeHtml="@BeforeHtml"
             AfterLabel="After - dotnet build"
             AfterHtml="@AfterHtml"/>

<section class="bg-body-secondary">
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">Use cases</span>
            <h2 class="display-custom">Where teams feel the difference.</h2>
        </div>
        <UseCaseGrid UseCases="@UseCases.ForProduct(p.Slug)"/>
    </div>
</section>


<section>
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">FAQ</span>
            <h2 class="display-custom">Common questions.</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <FaqAccordion Items="@Faqs.ResxTranslator" AccordionId="faqResx"/>
            </div>
        </div>
    </div>
</section>

<CrossSellBox CurrentSlug="@p.Slug"/>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private const string AisettingsHtml = """
