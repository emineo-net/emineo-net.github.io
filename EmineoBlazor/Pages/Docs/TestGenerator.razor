@page "/docs/test-generator"

<PageTitle>NetAI.TestGenerator – Documentation</PageTitle>

<DocsLayout PageTitle="Overview"
            Section="NetAI.TestGenerator"
            SectionUrl="/docs/test-generator"
            GitHubEditUrl="https://github.com/emineo-net/NetAI.TestGenerator/edit/main/README.md">
    <MarkdownView Markdown="@_md"/>
</DocsLayout>

@code {
    [Inject] private DocsContentService Docs { get; set; } = default!;

    private string _md = "";

    protected override async Task OnInitializedAsync()
    {
        _md = await Docs.GetMarkdownAsync("test-generator.md");
    }

}