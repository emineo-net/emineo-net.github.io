@page "/auth/forgot-password"
@using System.ComponentModel.DataAnnotations

<PageTitle>Passwort vergessen</PageTitle>

<div class="auth-container">
    <div class="card">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">Passwort zurücksetzen</h3>
            
            @if (showSuccessMessage) {
                <div class="alert alert-success">Falls die E-Mail existiert, wurde ein Reset-Link versendet.</div>
            } else {
                <EditForm Model="@forgotModel" OnValidSubmit="HandleForgotPassword">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">E-Mail-Adresse</label>
                        <InputText class="form-control" @bind-Value="forgotModel.Email" />
                        <ValidationMessage For="@(() => forgotModel.Email)" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">Link anfordern</button>
                </EditForm>
            }
            <div class="mt-3 text-center"><a href="auth/login">Zurück zum Login</a></div>
        </div>
    </div>
</div>

@code {
    private ForgotModel forgotModel = new();
    private bool isSubmitting = false, showSuccessMessage = false;

    private async Task HandleForgotPassword() {
        isSubmitting = true;
        await Task.Delay(1000);
        showSuccessMessage = true;
        isSubmitting = false;
    }

    public class ForgotModel { [Required, EmailAddress] public string Email { get; set; } = string.Empty; }
}