@page "/auth/reset-password"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation

<PageTitle>Neues Passwort vergeben</PageTitle>

<div class="auth-container">
    <div class="card">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">Neues Passwort erstellen</h3>

            <EditForm Model="@resetModel" OnValidSubmit="HandleResetPassword">
                <DataAnnotationsValidator />
                
                <div class="mb-3">
                    <label class="form-label">Neues Passwort</label>
                    <InputText type="password" class="form-control" @bind-Value="resetModel.Password" />
                    <ValidationMessage For="@(() => resetModel.Password)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Passwort bestätigen</label>
                    <InputText type="password" class="form-control" @bind-Value="resetModel.ConfirmPassword" />
                    <ValidationMessage For="@(() => resetModel.ConfirmPassword)" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">Speichern</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ResetModel resetModel = new();
    private bool isSubmitting = false;

    [Parameter] [SupplyParameterFromQuery] public string? Token { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? Email { get; set; }

    private async Task HandleResetPassword() {
        isSubmitting = true;
        await Task.Delay(1000);
        Navigation.NavigateTo("auth/login");
        isSubmitting = false;
    }

    public class ResetModel {
        [Required, MinLength(6)] public string Password { get; set; } = string.Empty;
        [Required, Compare(nameof(Password))] public string ConfirmPassword { get; set; } = string.Empty;
    }
}