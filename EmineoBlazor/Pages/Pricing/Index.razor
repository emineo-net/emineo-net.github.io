@page "/pricing"
@using EmineoBlazor.Components.Pricing
@using EmineoBlazor.Components.Marketing

<PageTitle>Pricing â€“ Emineo</PageTitle>

<header class="hero">
    <div class="container text-center">
        <div class="badge-soft mb-4 d-inline-block">
            <span class="dot"></span>
            MIT-licensed core Â· Enterprise support
        </div>
        <h1 class="hero-title mb-4 mx-auto" style="max-width: 900px;">
            Start for free.<br>
            <span class="text-gradient">Scale when you're ready.</span>
        </h1>
        <p class="lead-muted mx-auto" style="max-width: 680px;">
            Both products are MIT-licensed at their core â€” including commercial use.
            Enterprise licenses add the team-scale features and the contracts.
        </p>
    </div>
</header>

<section class="bg-body-secondary">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            @foreach (var card in Cards)
            {
                <div class="col-lg-4">
                    <PricingCard Title="@card.Title"
                                 Description="@card.Description"
                                 Featured="@card.Featured"
                                 RibbonLabel="@card.RibbonLabel"
                                 PriceAmount="@card.PriceAmount"
                                 PriceSuffix="@card.PriceSuffix"
                                 PriceNote="@card.PriceNote"
                                 Features="@card.Features"
                                 Ctas="@card.Ctas"
                                 FooterNote="@card.FooterNote" />
                </div>
            }
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">Compare plans</span>
            <h2 class="display-custom mb-3">MIT vs. Enterprise vs. Bundle.</h2>
            <p class="lead-muted mx-auto" style="max-width: 640px;">
                Same core engine. Enterprise adds the team-scale features â€” and the contracts.
            </p>
        </div>

        <ComparisonTable Columns="@Columns" Rows="@Rows" />
    </div>
</section>

<EnterpriseTrustBar />

@code {
    private static readonly string[] Columns = ["MIT", "Enterprise", "Bundle"];

    private static PricingCard.CtaItem Link(string label, string href, string css = "btn-outline-brand") =>
        new() { Label = label, Href = href, CssClass = css, IsLink = true,
                Target = href.StartsWith("http") ? "_blank" : null,
                Rel = href.StartsWith("http") ? "noopener" : null };

    private static PricingCard.CtaItem Button(string label, string css = "btn-brand") =>
        new() { Label = label, CssClass = css, IsLink = false };

    private sealed record CardData(
        string Title,
        string Description,
        bool Featured,
        string? RibbonLabel,
        string PriceAmount,
        string? PriceSuffix,
        string PriceNote,
