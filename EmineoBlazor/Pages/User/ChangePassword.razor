@page "/user/change-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

@attribute [Authorize]


<PageTitle>Passwort ändern</PageTitle>

<div class="container mt-4 row justify-content-center">
    <div class="col-md-6 card p-3">
        <h3 class="mb-3 text-center">Passwort ändern</h3>
        @if (showSuccess)
        {
            <div class="alert alert-success">Passwort geändert. Weiterleitung...</div>
        }

        <EditForm Model="@changeModel" OnValidSubmit="HandleChangePassword">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Aktuelles Passwort</label>
                <InputText type="password" class="form-control" @bind-Value="changeModel.CurrentPassword" />
            </div>
            <div class="mb-3">
                <label class="form-label">Neues Passwort</label>
                <InputText type="password" class="form-control" @bind-Value="changeModel.NewPassword" />
            </div>
            <div class="mb-3">
                <label class="form-label">Neues Passwort bestätigen</label>
                <InputText type="password" class="form-control" @bind-Value="changeModel.ConfirmPassword" />
            </div>
            <div class="d-flex justify-content-between">
                <a href="/user/profile" class="btn btn-light">Abbrechen</a>
                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">Aktualisieren</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private ChangeModel changeModel = new();
    private bool isSubmitting = false, showSuccess = false;

    private async Task HandleChangePassword()
    {
        isSubmitting = true;
        await Task.Delay(1000);
        showSuccess = true;
        await Task.Delay(1000);
        Navigation.NavigateTo("/user/profile");
        isSubmitting = false;
    }

    public class ChangeModel
    {
        [Required] public string CurrentPassword { get; set; } = string.Empty;
        [Required, MinLength(6)] public string NewPassword { get; set; } = string.Empty;
        [Required, Compare(nameof(NewPassword))] public string ConfirmPassword { get; set; } = string.Empty;
    }
}
